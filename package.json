{
  "name": "@sudobility/resources_pages",
  "version": "0.1.1",
  "description": "Web UI components for the Sudobility resources catalog (tile grid of language-specific helper links)",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "CLAUDE.md"
  ],
  "scripts": {
    "build": "tsc && vite build && node scripts/fix-esm-imports.mjs",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "typecheck": "bunx tsc --noEmit",
    "lint": "bunx eslint src",
    "lint:fix": "bunx eslint src --fix",
    "format": "bunx prettier --write \"src/**/*.{ts,tsx}\"",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "verify": "bun run typecheck && bun run lint && bun run test:unit && bun run build",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "@sudobility/design": "^1.1.71",
    "@sudobility/resources_client": "^0.1.0",
    "@sudobility/types": "^1.9.79",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "~10.0.1",
    "@sudobility/design": "^1.1.71",
    "@sudobility/resources_client": "^0.1.0",
    "@sudobility/types": "^1.9.79",
    "@testing-library/jest-dom": "~7.0.1",
    "@testing-library/react": "~16.3.3",
    "@types/bun": "~1.4.4",
    "@types/node": "~26.6.5",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "~8.72.0",
    "@typescript-eslint/parser": "~8.72.0",
    "@vitejs/plugin-react": "~6.1.2",
    "ajv": "~8.20.0",
    "eslint": "~10.13.0",
    "eslint-plugin-react-hooks": "~7.1.1",
    "eslint-plugin-react-refresh": "~0.4.26",
    "globals": "~17.13.0",
    "jsdom": "~30.1.3",
    "prettier": "~3.9.10",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.72.0",
    "vite": "~8.3.5",
    "vite-plugin-dts": "~4.5.4",
    "vitest": "~4.1.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "BUSL-1.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/resources_pages.git"
  }
}
